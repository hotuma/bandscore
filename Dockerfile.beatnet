FROM python:3.11-slim

# システムパッケージのインストール
RUN apt-get update && apt-get install -y \
    build-essential \
    libsndfile1 \
    ffmpeg \
    portaudio19-dev \
    && rm -rf /var/lib/apt/lists/*

# 作業ディレクトリの設定
WORKDIR /app

# pipをアップグレード
RUN pip install --upgrade pip setuptools wheel

# Pythonパッケージのインストール（madmom 互換性のために numpy<1.24）
RUN pip install --no-cache-dir \
    numpy==1.23.5 \
    scipy==1.11.4 \
    librosa==0.10.1 \
    soundfile==0.12.1 \
    torch==2.2.0

# Cythonをインストール
RUN pip install --no-cache-dir cython

# madmomをインストール（ビルドに時間がかかります）
RUN pip install --no-cache-dir --no-build-isolation madmom==0.16.1

# BeatNetをインストール
RUN pip install --no-cache-dir BeatNet==1.1.1

# numpy をダウングレード（BeatNet がアップグレードするため、madmom 互換性のために戻す）
RUN pip install --no-cache-dir --force-reinstall 'numpy==1.23.5'

# pyaudioをインストール
RUN pip install --no-cache-dir pyaudio

# setuptools を下げて pkg_resources を有効にする
RUN pip install --no-cache-dir 'setuptools<72' --force-reinstall

# API関連パッケージをインストール
RUN pip install --no-cache-dir \
    fastapi==0.104.1 \
    uvicorn==0.24.0 \
    python-multipart==0.0.6

# APIサービスのコピー
COPY backend/beatnet_service.py /app/

# ポート8000を公開
EXPOSE 8000

# サービス起動
CMD ["uvicorn", "beatnet_service:app", "--host", "0.0.0.0", "--port", "8000"]
